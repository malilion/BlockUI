{
  "name": "@malilion/block-ui-tokens",
  "version": "0.2.0",
  "description": "Design tokens (colors, spacing, typography, motion…) for Block UI.",
  "license": "MIT",
  "author": "Block UI Contributors",
  "homepage": "https://malilion.github.io/BlockUI/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malilion/BlockUI.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/malilion/BlockUI/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@block-ui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tokens.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/generate-css.mjs",
    "generate": "tsc -p tsconfig.build.json && node scripts/generate-css.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "block-ui",
    "design-tokens",
    "pixel"
  ]
}
