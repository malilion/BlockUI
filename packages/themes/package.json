{
  "name": "@malilion/block-ui-themes",
  "version": "0.6.1",
  "description": "Themes (grassland, cave, deepslate, nether, end) for Block UI.",
  "license": "MIT",
  "author": "Block UI Contributors",
  "homepage": "https://malilion.github.io/BlockUI/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malilion/BlockUI.git",
    "directory": "packages/themes"
  },
  "bugs": {
    "url": "https://github.com/malilion/BlockUI/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@block-ui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./themes.css": "./themes.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "themes.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/generate-css.mjs",
    "generate": "tsc -p tsconfig.build.json && node scripts/generate-css.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "block-ui",
    "themes",
    "pixel"
  ],
  "dependencies": {
    "@malilion/block-ui-tokens": "workspace:^"
  }
}
