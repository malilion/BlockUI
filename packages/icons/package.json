{
  "name": "@block-ui/icons",
  "version": "0.1.0",
  "description": "Pixel-art React icons (16 × 16 grid) for Block UI.",
  "license": "MIT",
  "author": "Block UI Contributors",
  "homepage": "https://malilion.github.io/BlockUI/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malilion/BlockUI.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/malilion/BlockUI/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@block-ui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@block-ui/tokens": "workspace:^"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "block-ui",
    "icons",
    "pixel-art",
    "react"
  ]
}
