{
  "name": "@block-ui/react",
  "version": "0.1.0",
  "description": "Block UI — block / pixel / crafting game-style React components: inventory, crafting, HUD, cards, forms and more.",
  "license": "MIT",
  "author": "Block UI Contributors",
  "homepage": "https://malilion.github.io/BlockUI/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malilion/BlockUI.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/malilion/BlockUI/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@block-ui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "@block-ui/source": "./src/styles/index.css",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@block-ui/icons": "workspace:^",
    "@block-ui/themes": "workspace:^",
    "@block-ui/tokens": "workspace:^"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "ui",
    "component-library",
    "pixel",
    "block",
    "game-ui",
    "inventory",
    "crafting",
    "hud"
  ]
}
